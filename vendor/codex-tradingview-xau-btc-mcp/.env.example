# TradingView CDP
TRADINGVIEW_CDP_HOST=127.0.0.1
TRADINGVIEW_CDP_PORT=9222
# Optional. Useful for Microsoft Store/WindowsApps installs when auto-detection fails.
TRADINGVIEW_EXE_PATH=

# Codex TradingView MCP local state
CODEX_TV_MCP_HOME=.codex-tv-mcp

# Timezone and news blackout
TIMEZONE=Europe/Paris
BLACKOUT_BEFORE_MINUTES=30
BLACKOUT_AFTER_MINUTES=15
FOMC_BLACKOUT_BEFORE_MINUTES=60
FOMC_BLACKOUT_AFTER_MINUTES=45

# News/fundamentals providers
FINNHUB_API_KEY=
FRED_API_KEY=
COINGECKO_API_KEY=
BRAVE_SEARCH_API_KEY=
CRYPTOPANIC_API_KEY=

# Optional files
MANUAL_CALENDAR_PATH=./data/manual_calendar.json
RSS_SOURCES_PATH=./data/rss_sources.json

# HTTP/cache
REQUEST_TIMEOUT_MS=12000
CACHE_TTL_SECONDS=120
